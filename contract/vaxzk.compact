pragma language_version >= 0.20;

import CompactStandardLibrary;

import "./Types";

export { ClinicProfile, UserProfile, CertIssuerInfo, VaccineProofRequest, VaxZkProof, SchnorrSignature, schnorrChallengeVaxZk };

include 'Invites';

// Public ledger of shielded clinic IDs.
export ledger clinics: Map<Bytes<32>, ClinicProfile>;
export ledger ownerClinicIndex: Map<Bytes<32>, Boolean>;

// Public ledger of vaccines list.
export ledger vaccines: Set<Bytes<20>>;

// Map of vaccine certificate issuers indexed by assigned ID
export ledger issuers: Map<Bytes<32>, CertIssuerInfo>;

// Counter used to generate issuers Ids
export ledger issuerId: Counter;

// Counter used to generate vaccine proof requests Ids
export ledger proofReqId: Counter;

// Map of vaccine proof requests indexed by assigned ID
export ledger vaccineProofReqs: Map<Bytes<32>, VaccineProofRequest>;

// Map of sumitted vaccine proofs indexed by request ID
export ledger vaccineProofs: Map<Bytes<32>, VaxZkProof>;

// Reads the caller's 32-byte secret key from local private state.
witness localSk(): Bytes<32>;

// Obtain the vaccine certificate proof signed by a registered issuer
witness getAttestedCertProofWitness(): VaxZkProof;

// Registers the deployer as the first admin by inserting their shielded ID.
constructor() {
  const own = ownPublicKey();
  const adminId = getShieldedId(own.bytes);
  admins.insert(disclose(adminId));

  issuerId.increment(1);
  proofReqId.increment(1);

  // Init some Vaccines
  vaccines.insert(disclose(pad(20, "HepB")));
  vaccines.insert(disclose(pad(20, "PCV")));
  vaccines.insert(disclose(pad(20, "Tdap")));

  // Init clinics
  clinics.insert(disclose(pad(32, "clinic1")), disclose(ClinicProfile { name: pad(32, "Clinic 1"), address: pad(64, "123 Main St"), ownerId: disclose(adminId), urlImage: disclose(pad(64, "https://example.com/clinic1.png")), latitud: disclose(pad(20, "-23.5990263")), longitud: disclose(pad(20, "-46.6419712")), isOnline: disclose(true) }));
  ownerClinicIndex.insert(disclose(adminId), disclose(true));
  clinics.insert(disclose(pad(32, "clinic22")), disclose(ClinicProfile { name: pad(32, "Clinic Local 22"), address: pad(64, "123 Main St"), ownerId: disclose(adminId), urlImage: disclose(pad(64, "https://example.com/clinic22.png")), latitud: disclose(pad(20, "-23.5990263")), longitud: disclose(pad(20, "-46.6419712")), isOnline: disclose(true) }));
}

// Derives a deterministic shielded ID using a persistent hash.
export circuit getShieldedId(id: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "registered-entity-id:"), id]);
}

circuit getCertIssuerId(): Bytes<32> {
  const newIssuerId =
          persistentHash<Vector<2, Field>>([pad(32, "cert-issuer-id:") as Field, issuerId as Field]);
  issuerId.increment(1);
  return newIssuerId;
}

// Generate a new cert proof request ID.
circuit getProofReqId(): Bytes<32> {
  const newProofReqId =
          persistentHash<Vector<2, Field>>([pad(32, "proof-req-id:") as Field, proofReqId as Field]);
  proofReqId.increment(1);
  return newProofReqId;
}

// Guards: aborts the calling circuit if the caller is not a registered admin.
circuit isAdmin(): [] {
  const own = ownPublicKey();
  const adminId = getShieldedId(own.bytes);
  assert(admins.member(disclose(adminId)), "You are not an admin");
}

// Guards: aborts the calling circuit if the caller is not a registered clinic.
circuit isClinic(): [] {
  const own = ownPublicKey();
  const ownerId = getShieldedId(own.bytes);
  assert(ownerClinicIndex.member(disclose(ownerId)), "You are not a registered clinic");
}

// Removes an admin by their shielded ID. Caller must be an existing admin.
export circuit revokeAdmin(adminId: Bytes<32>): [] {
  isAdmin();
  assert(!admins.member(disclose(adminId)), "Admin ID is not in the admins list");
  admins.remove(disclose(adminId));
}

// Registers a clinic by their shielded ID and profile info. Caller must be an admin.
export circuit addClinic(clinicId: Bytes<32>, clinicProfile: ClinicProfile): [] {
  isAdmin();
  assert(!clinics.member(disclose(clinicId)), "The ID is already in the clinics list");
  clinics.insert(disclose(clinicId), disclose(clinicProfile));
  ownerClinicIndex.insert(disclose(clinicProfile.ownerId), disclose(true));
}

// Removes a clinic by their shielded ID. Caller must be an admin.
export circuit revokeClinic(clinicId: Bytes<32>): [] {
  isAdmin();
  assert(!clinics.member(disclose(clinicId)), "Clinic ID is not in the clinics list");
  clinics.remove(disclose(clinicId));
}

// Registers a vaccine certificate issuer. Caller must be an admin.
export circuit addCertificateIssuer(issuerInfo: CertIssuerInfo): Bytes<32> {
  isAdmin();
  const newIssuerId = getCertIssuerId();
  assert(!issuers.member(disclose(newIssuerId)), "The ID is already in the issuers list");
  issuers.insert(disclose(newIssuerId), disclose(issuerInfo));
  return newIssuerId;
}

export circuit getProfile(): UserProfile {
  const own = ownPublicKey();
  const adminId = getShieldedId(own.bytes);
  const validAdmin = admins.member(disclose(adminId));
  const validClinic = ownerClinicIndex.member(disclose(adminId));

  return UserProfile { isAdmin: validAdmin, isClinic: validClinic };
}

// Vaccines
export circuit addVaccine(name: Bytes<20>): [] {
  isAdmin();
  assert(!vaccines.member(disclose(name)), "Vaccine type already registered");
  vaccines.insert(disclose(name));
}

export circuit delVaccine(name: Bytes<20>): [] {
  isAdmin();
  assert(vaccines.member(disclose(name)), "Vaccine type is not registered");
  vaccines.remove(disclose(name));
}

// Registers a new vaccine proof request. Caller must be a clinic.
export circuit requestVaccineProof(req: VaccineProofRequest): Bytes<32> {
  isClinic();
  const newProofReqId = getProofReqId();
  assert(!vaccineProofReqs.member(disclose(newProofReqId)),
         "The ID is already in the vaccine proof requests list"
         );
  vaccineProofReqs.insert(disclose(newProofReqId), disclose(req));
  return newProofReqId;
}

// Submits a requested vaccine proof.
export circuit submitVaccineProof(proofReqId: Bytes<32>): [] {
  assert(vaccineProofReqs.member(disclose(proofReqId)),
         "The ID is not the vaccine proof requests list"
         );
  assert(!vaccineProofs.member(disclose(proofReqId)),
         "The vaccine proof for the given request ID has been already submitted"
         );

  const proof = getAttestedCertProofWitness();
  const issuerId = disclose(proof.issuerId);
  assert(issuers.member(issuerId), "The vaccine proof issuer is not a registered/valid entity");

  const vaccineProofReq = vaccineProofReqs.lookup(disclose(proofReqId));
  const proofIssuer = issuers.lookup(issuerId);

  assert(proof.vaccine == vaccineProofReq.vaccine,
         "The submitted proof doesn't match the vaccine type"
         );
  assert(proof.personalId == vaccineProofReq.personalId,
         "The submitted proof doesn't match the passport or ID number"
         );
  assert(proof.expirationDate >= vaccineProofReq.validUntil,
         "The submitted certificate proof doesn't comply with validity date"
         );

  // Verify attestation signature using native Compact types — no Field
  // range conversions required.
  const userPubKey = getShieldedId(ownPublicKey().bytes);
  schnorrVerifyVaxZk(
    proof.vaccine,
    proof.personalId,
    proof.expirationDate,
    userPubKey,
    proof.issuerSignature,
    proofIssuer.key
    );

  vaccineProofs.insert(disclose(proofReqId), disclose(proof));
}
