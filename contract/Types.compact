module Types {
  import CompactStandardLibrary;

  import "./Schnorr";
  export { SchnorrSignature, schnorrVerifyVaxZk, schnorrChallengeVaxZk };

  // Vaccine certificate issuer. `key` is the JubJub public key for Schnorr
  // verification; the corresponding secret key stays off-chain with the issuer.
  export struct CertIssuerInfo {
    // issuer DID or URL (e.g., "did:example:who" or "https://who.int")
    uri: Opaque<'string'>,
    // human-readable name
    name: Opaque<'string'>,
    // known verification key
    key: JubjubPoint,
    // URL for verification checks
    verificationEndpoint: Opaque<'string'>,
  }

  // Proof request created by a verifier. All fields are public on the ledger
  // once inserted — `personalId` is visible to any ledger reader.
  export struct VaccineProofRequest {
    // Vaccine product/type
    vaccine: Bytes<20>,
    // Passport or ID number associated to vaccine certificate
    personalId: Bytes<20>,
    // Minimum vaccine validity timestamp
    validUntil: Uint<128>,
  }

  // Full vaccine certificate stored in the user's local encrypted private state.
  // Fields are only disclosed on-chain after all circuit assertions pass in `submitVaccineProof`.
  export struct VaxZkProof {
    // Vaccine certificate issuer assinged ID
    issuerId: Bytes<32>,
    // Vaccine product/type
    vaccine: Bytes<20>,
    // Passport or ID number associated to vaccine certificate
    personalId: Bytes<20>,
    // Certificate expiration timestamp
    expirationDate: Uint<128>,
    // Issuer signature over the vaccine certificate
    issuerSignature: SchnorrSignature
  }

  // Verifier/clinic profile. `ownerId` is a shielded wallet ID (not a raw key).
  // Location fields are intentionally public for map-based discovery.
  export struct ClinicProfile {
    ownerId: Bytes<32>,
    name: Bytes<32>,
    address: Bytes<64>,
    latitud: Bytes<20>,
    longitud: Bytes<20>,
    isOnline: Boolean
  }

}
