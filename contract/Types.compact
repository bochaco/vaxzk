module Types {
  import CompactStandardLibrary;

  import "./Schnorr";
  export { SchnorrSignature, schnorrVerifyVaxZk, schnorrChallengeVaxZk };

  // Vaccine certificate issuer metadata
  export struct CertIssuerInfo {
    // issuer DID or URL (e.g., "did:example:who" or "https://who.int")
    uri: Opaque<'string'>,
    // human-readable name
    name: Opaque<'string'>,
    // known verification key
    key: JubjubPoint,
    // URL for verification checks
    verificationEndpoint: Opaque<'string'>,
  }

  // Vaccine proof request
  export struct VaccineProofRequest {
    // Vaccine product/type
    vaccine: Bytes<20>,
    // Passport or ID number associated to vaccine certificate
    personalId: Bytes<20>,
    // Minimum vaccine validity timestamp
    validUntil: Uint<128>,
  }

  // Vaccine proof
  export struct VaxZkProof {
    // Vaccine certificate issuer assinged ID
    issuerId: Bytes<32>,
    // Vaccine product/type
    vaccine: Bytes<20>,
    // Passport or ID number associated to vaccine certificate
    personalId: Bytes<20>,
    // Certificate expiration timestamp
    expirationDate: Uint<128>,
    // Issuer signature over the vaccine certificate
    issuerSignature: SchnorrSignature
  }

  // Clinic Profile
  export struct ClinicProfileInfo {
    // Clinic DID or URL (e.g., "did:example:clinic" or "https://clinic.example.com")
    uri: Opaque<'string'>,
    // Human-readable clinic name
    name: Opaque<'string'>,
    // Human-readable location description (city, address, etc.)
    location: Opaque<'string'>,
    // Latitude in microdegrees (degrees × 10^6, signed as Field)
    latitude: Field,
    // Longitude in microdegrees (degrees × 10^6, signed as Field)
    longitude: Field,
    // Image URL or base64-encoded image data
    image: Opaque<'string'>,
  }

}
