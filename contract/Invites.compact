import CompactStandardLibrary;

export ledger inviteHash: Bytes<32>;

witness inviteSecret(): Bytes<32>;
witness inviteNonce(): Bytes<32>;

circuit createInviteHash(secret: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(secret, nonce);
}

export circuit registerInvite(): Bytes<32> {
  const secret = inviteSecret();
  const nonce = inviteNonce();
  inviteHash = disclose(createInviteHash(secret, nonce));
  return disclose(inviteHash);
}

export circuit useInvite(_secret: Bytes<32>, _nonce: Bytes<32>): [] {
  const hash = createInviteHash(_secret, _nonce);
  assert(inviteHash == hash, "Convite inválido");
}