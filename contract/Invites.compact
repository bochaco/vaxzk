import CompactStandardLibrary;

export ledger inviteAdminHash: Bytes<32>;

witness inviteNonce(): Bytes<32>;

export circuit registerInvite(secret: Bytes<32>): Bytes<32> {
  const nonce = inviteNonce();
  const hash = disclose(persistentHash<Vector<2, Bytes<32>>>([secret, nonce]));
  inviteAdminHash = hash;
  return hash;
}

export circuit isValidInvite(_secret: Bytes<32>): Bytes<32> {
  const nonce = inviteNonce();
  const actualHash = disclose(persistentHash<Vector<2, Bytes<32>>>([_secret, nonce]));
  return actualHash;
}