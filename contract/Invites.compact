import CompactStandardLibrary;

witness inviteNonce(): Bytes<32>;

ledger inviteAdminHash: Set<Bytes<32>>;

export circuit registerInviteAdmin(secret: Bytes<32>): Bytes<32> {
  const nonce = inviteNonce();
  const hash = persistentCommit<Bytes<32>>(secret, nonce);

  inviteAdminHash.insert(disclose(hash));
  return disclose(hash);
}