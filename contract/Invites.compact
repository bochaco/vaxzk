// Invite-based access control. Codes are stored verbatim on the public ledger
// and consumed (one-time use) when accepted. Use a large random nonce so codes
// cannot be brute-forced before the recipient accepts.
import CompactStandardLibrary;

export ledger admins: Set<Bytes<32>>;

export ledger inviteAdminHash: Set<Bytes<32>>;

export ledger ownerClinics: Set<Bytes<32>>;

export ledger inviteClinicHash: Set<Bytes<32>>;

witness inviteNonce(): Bytes<32>;

// Routes invite codes into `inviteAdminHash` or `inviteClinicHash` sets.
export enum Role {
  admin,
  clinic
}

// Guards: aborts the calling circuit if the caller is not a registered admin.
circuit isAdmin(): [] {
  const own = ownPublicKey();
  const adminId = getShieldedId(own.bytes);
  assert(admins.member(disclose(adminId)), "You are not an admin");
}

// Guards: aborts the calling circuit if the caller is not a registered clinic.
circuit isClinic(): [] {
  const own = ownPublicKey();
  const ownerId = getShieldedId(own.bytes);
  assert(ownerClinics.member(disclose(ownerId)), "You are not a registered clinic");
}

// Admin-only. Registers a one-time invite code for the given role.
export circuit registerInvite(role: Role, inviteCode: Bytes<32>): [] {
  isAdmin();

  const d_role = disclose(role);
  if (d_role == Role.clinic) {
    inviteClinicHash.insert(disclose(inviteCode));
  } else if (d_role == Role.admin) {
    inviteAdminHash.insert(disclose(inviteCode));
  }
}

// Open to any caller. Redeems an invite code (one-time use) and promotes the
// caller to the specified role. Reverts if the code is invalid or the caller
// already holds that role.
export circuit acceptInvite(role: Role, inviteCode: Bytes<32>): [] {
  const d_role = disclose(role);
  const d_inviteCode = disclose(inviteCode);
  const own = ownPublicKey();

  if (d_role == Role.clinic) {
    assert(inviteClinicHash.member(d_inviteCode), "Invalid clinic invite code");

    const ownerId = getShieldedId(own.bytes);
    assert(!ownerClinics.member(disclose(ownerId)), "user is already a clinic");
    ownerClinics.insert(disclose(ownerId));

    inviteClinicHash.remove(d_inviteCode);
  } else if (d_role == Role.admin) {
    assert(inviteAdminHash.member(d_inviteCode), "Invalid admin invite code");

    const adminId = getShieldedId(own.bytes);
    assert(!admins.member(disclose(adminId)), "user is already an admin");
    admins.insert(disclose(adminId));

    inviteAdminHash.remove(d_inviteCode);
  }
}

// Admin-only self-revocation. No guard against removing the last admin.
export circuit revokeAdmin(): [] {
  isAdmin();

  const own = ownPublicKey();
  const adminId = getShieldedId(own.bytes);

  admins.remove(disclose(adminId));
}
