import CompactStandardLibrary;

export ledger admins: Set<Bytes<32>>;

ledger ownerClinics: Set<Bytes<32>>;
export ledger totalOwnerClinics: Uint<64>;

ledger inviteAdminHash: Set<Bytes<32>>;
export ledger totalInviteAdmin: Uint<64>;

ledger inviteClinicHash: Set<Bytes<32>>;
export ledger totalInviteClinic: Uint<64>;

witness inviteNonce(): Bytes<32>;

// Guards: aborts the calling circuit if the caller is not a registered admin.
circuit isAdmin(): [] {
  const own = ownPublicKey();
  const adminId = getShieldedId(own.bytes);
  assert(admins.member(disclose(adminId)), "You are not an admin");
}

// Guards: aborts the calling circuit if the caller is not a registered clinic.
circuit isClinic(): [] {
  const own = ownPublicKey();
  const ownerId = getShieldedId(own.bytes);
  assert(ownerClinics.member(disclose(ownerId)), "You are not a registered clinic");
}

export circuit registerInviteAdmin(inviteCode: Bytes<32>): [] {
  isAdmin();
  inviteAdminHash.insert(disclose(inviteCode));
}

export circuit acceptInviteAdmin(inviteCode: Bytes<32>): [] {
  assert(inviteAdminHash.member(disclose(inviteCode)), "Invalid invite code");

  const own = ownPublicKey();
  const adminId = getShieldedId(own.bytes);

  assert(!admins.member(disclose(adminId)), "user is already an admin");
  admins.insert(disclose(adminId));

  inviteAdminHash.remove(disclose(inviteCode));
}

export circuit registerInviteClinic(inviteCode: Bytes<32>): [] {
  isAdmin();
  inviteClinicHash.insert(disclose(inviteCode));
  totalInviteClinic = inviteClinicHash.size();
}

export circuit acceptInviteClinic(inviteCode: Bytes<32>): [] {
  assert(inviteClinicHash.member(disclose(inviteCode)), "Invalid invite code");

  const own = ownPublicKey();
  const ownerId = getShieldedId(own.bytes);

  assert(!ownerClinics.member(disclose(ownerId)), "user is already a clinic");
  ownerClinics.insert(disclose(ownerId));
  totalInviteClinic = ownerClinics.size();

  inviteClinicHash.remove(disclose(inviteCode));
  totalInviteClinic = inviteClinicHash.size();
}

export circuit revokeAdmin(): [] {
  isAdmin();

  const own = ownPublicKey();
  const adminId = getShieldedId(own.bytes);

  admins.remove(disclose(adminId));
}

export circuit registerInviteClinic(inviteCode: Bytes<32>): [] {
  isClinic();
  inviteClinicHash.insert(disclose(inviteCode));
}

