{
  "name": "connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "preview": "vite preview",
    "contract:compile": "compact compile contract/vaxzk.compact contract/managed && npm run contract:copy-assets",
    "contract:copy-assets": "mkdir -p public && cp -r contract/managed/keys public/ && cp -r contract/managed/zkir public/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^3.1.0",
    "buffer": "^6.0.3",
    "leaflet": "^1.9.4",
    "node-stdlib-browser": "^1.3.1",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.0",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0",
    "vite-plugin-node-polyfills": "^0.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "init": "^0.1.2",
    "npx": "^10.2.2",
    "rollup": "^4.60.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
